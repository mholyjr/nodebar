    "$CLEAN_HOME/Library/Caches/node/corepack" \
    "$CLEAN_HOME/Library/Caches/corepack" \
    "$CLEAN_HOME/.cache/node/corepack"; do
    [[ "$path" == "$expected" ]] && return 0
  done
  return 1
}

is_npx_child_path() {
  local path="$1" parent
  parent=${path%/*}
  [[ "$parent" == "$CLEAN_HOME/.npm/_npx" && "${path##*/}" != "" ]]
}

validate_cache_path() {
  local path="$1" resolved
  [[ -e "$path" && ! -L "$path" && -d "$path" ]] || return 1
  resolved=$(resolve_path "$path") || return 1
  [[ "$resolved" == "$path" ]] || return 1
  is_exact_cache_path "$path" || is_npx_child_path "$path"
}

add_cache_if_safe() {
  local kind="$1" path="$2" label="$3" process_pattern="${4:-}" size ref_status process_status
  [[ -e "$path" ]] || return 0
  progress_status "Inspecting $label: $path"
  if ! validate_cache_path "$path"; then
    add_protected "$label — $path" "path validation rejected it"
    return 0
  fi
  if [[ -n "$process_pattern" ]]; then
    if process_pattern_active "$process_pattern"; then
      process_status=0
    else
      process_status=$?
    fi
    if (( process_status == 0 )); then
      add_protected "$label — $path" "a relevant process is running"
      return 0
    elif (( process_status == 2 )); then
      add_protected "$label — $path" "active-process state could not be verified (pgrep unavailable)"
      return 0
    fi
  fi
  if path_is_active "$path" "$label"; then
    ref_status=0
  else
    ref_status=$?
  fi
  if (( ref_status == 0 )); then
    add_protected "$label — $path" "an active process references this path"
    return 0
  elif (( ref_status == 2 )); then
    add_protected "$label — $path" "active-path state could not be verified (lsof or ps unavailable)"
    return 0
  fi
  size=$(path_size_kb "$path") || {
    add_protected "$label — $path" "size/readability could not be verified"
    return 0
  }
  if (( size == 0 )); then
    return 0
  fi
  add_candidate "$kind" "$path" "$label" "$size"
}

contains_value() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

stale_metadata_is_safe_to_prune() {
  local repo="$1" record path="" head="" branch="" flags="" main_seen=0 found=0 oid reachable listing
  listing=$(git -C "$repo" worktree list --porcelain 2>/dev/null) || return 2
  while IFS= read -r record || [[ -n "$record" ]]; do
    if [[ -z "$record" ]]; then
      if [[ -n "$path" ]]; then
        if (( main_seen == 0 )); then
          main_seen=1
        elif [[ "$flags" == *" prunable "* || ! -e "$path" ]]; then
          [[ "$flags" != *" locked "* && ! -e "$path" && -n "$head" ]] || return 1
          if [[ "$branch" == refs/heads/* ]]; then
            oid=$(git -C "$repo" rev-parse --verify "$branch" 2>/dev/null) || return 1
            [[ "$oid" == "$head" ]] || return 1
          else
            reachable=$(git -C "$repo" for-each-ref --format='%(refname)' --contains "$head" 2>/dev/null) || return 1
            [[ -n "$reachable" ]] || return 1
          fi
          found=1
        fi
      fi
      path=""; head=""; branch=""; flags=""
      continue
    fi
    case "$record" in
      worktree\ *) path=${record#worktree } ;;
      HEAD\ *) head=${record#HEAD } ;;
      branch\ *) branch=${record#branch } ;;
      locked*) flags="$flags locked " ;;
      prunable*) flags="$flags prunable " ;;
    esac
  done <<< "$listing"$'\n'
  (( found == 1 ))
}

repo_has_stale_metadata() {
  local repo="$1" record path="" flags="" main_seen=0 listing
  listing=$(git -C "$repo" worktree list --porcelain 2>/dev/null) || return 2
  while IFS= read -r record || [[ -n "$record" ]]; do
    if [[ -z "$record" ]]; then
      if [[ -n "$path" ]]; then
        if (( main_seen == 0 )); then
          main_seen=1
        elif [[ "$flags" == *" prunable "* || ! -e "$path" ]]; then
          return 0
        fi
      fi
      path=""; flags=""
      continue
    fi
    case "$record" in
      worktree\ *) path=${record#worktree } ;;
      prunable*) flags="$flags prunable " ;;
    esac
  done <<< "$listing"$'\n'
  return 1
}

snapshot_stale_branch_refs() {
  local repo="$1" record path="" branch="" flags="" main_seen=0 oid listing
  listing=$(git -C "$repo" worktree list --porcelain 2>/dev/null) || return 1
  while IFS= read -r record || [[ -n "$record" ]]; do
    if [[ -z "$record" ]]; then
      if [[ -n "$path" ]]; then
        if (( main_seen == 0 )); then
          main_seen=1
        elif [[ "$flags" == *" prunable "* || ! -e "$path" ]] && [[ "$branch" == refs/heads/* ]]; then
          oid=$(git -C "$repo" rev-parse --verify "$branch" 2>/dev/null) || return 1
          printf '%s\t%s\n' "$branch" "$oid"
        fi
      fi
      path=""; branch=""; flags=""
      continue
    fi
    case "$record" in
      worktree\ *) path=${record#worktree } ;;
      branch\ *) branch=${record#branch } ;;
      prunable*) flags="$flags prunable " ;;
    esac
  done <<< "$listing"$'\n'
}

verify_ref_snapshot() {
  local repo="$1" snapshot="$2" ref expected current
  [[ -n "$snapshot" ]] || return 0
  while IFS=$'\t' read -r ref expected; do
    [[ -n "$ref" && -n "$expected" ]] || return 1
    current=$(git -C "$repo" rev-parse --verify "$ref" 2>/dev/null) || return 1
    [[ "$current" == "$expected" ]] || return 1
  done <<< "$snapshot"
}

discover_worktrees_from_repo() {
  local repo="$1" record path="" head="" branch="" flags="" main_path=""
  local size status_output ref_status oid stale_refs listing
  listing=$(git -C "$repo" worktree list --porcelain 2>/dev/null) || {
    add_protected "Repository worktrees — $repo" "Git worktree metadata could not be listed"
    return 0
  }
  progress_status "Inspecting repository worktrees: $repo"
  while IFS= read -r record || [[ -n "$record" ]]; do
    if [[ -z "$record" ]]; then
      if [[ -n "$path" ]]; then
        if [[ -z "$main_path" ]]; then
          main_path="$path"
          progress_status "Keeping primary worktree: $path"
        elif [[ "$flags" == *" prunable "* ]]; then
          progress_status "Inspecting stale worktree metadata: $path"
          add_protected "Linked worktree — $path" "Git marks its metadata as prunable or broken"
        elif [[ "$flags" == *" locked "* ]]; then
          progress_status "Inspecting linked worktree: $path"
          add_protected "Linked worktree — $path" "worktree is locked"
        elif [[ ! -d "$path" || ! -e "$path/.git" ]]; then
          progress_status "Inspecting linked worktree: $path"
          add_protected "Linked worktree — $path" "worktree path or metadata is missing"
        elif [[ -z "$branch" || "$branch" != refs/heads/* ]]; then
          progress_status "Inspecting linked worktree: $path"
          add_protected "Linked worktree — $path" "detached or unverifiable HEAD has no branch ref to preserve"
        elif ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          progress_status "Inspecting linked worktree: $path"
          add_protected "Linked worktree — $path" "Git state could not be verified"
        else
          progress_status "Inspecting linked worktree: $path"
          status_output=$(GIT_OPTIONAL_LOCKS=0 git -C "$path" status --porcelain --untracked-files=all 2>/dev/null) || status_output="__STATUS_FAILED__"
          if [[ "$status_output" == "__STATUS_FAILED__" ]]; then
            add_protected "Linked worktree — $path" "cleanliness could not be verified"
          elif [[ -n "$status_output" ]]; then
            add_protected "Linked worktree — $path" "dirty or contains untracked files"
          else
            if path_is_active "$path" "linked worktree"; then
              ref_status=0
            else
              ref_status=$?
            fi
            if (( ref_status == 0 )); then
              add_protected "Linked worktree — $path" "an active process references this path"
            elif (( ref_status == 2 )); then
              add_protected "Linked worktree — $path" "active-path state could not be verified (lsof or ps unavailable)"
            else
              oid=$(git -C "$main_path" rev-parse --verify "$branch" 2>/dev/null) || oid=""
              if [[ -z "$oid" || "$oid" != "$head" ]]; then
                add_protected "Linked worktree — $path" "branch ref and worktree HEAD do not match"
              else
                size=$(path_size_kb "$path") || size=0
                add_candidate "worktree" "$path" "Linked worktree (${branch#refs/heads/})" "$size" "$main_path" "$branch" "$oid"
              fi
            fi
          fi
        fi
      fi
      path=""; head=""; branch=""; flags=""
      continue
    fi
    case "$record" in
      worktree\ *) path=${record#worktree } ;;
      HEAD\ *) head=${record#HEAD } ;;
      branch\ *) branch=${record#branch } ;;
      locked*) flags="$flags locked " ;;
      prunable*) flags="$flags prunable " ;;
      detached) flags="$flags detached " ;;
    esac
  done <<< "$listing"$'\n'

  if [[ -n "$main_path" ]] && stale_metadata_is_safe_to_prune "$main_path"; then
    if stale_refs=$(snapshot_stale_branch_refs "$main_path"); then
      add_candidate "worktree-prune" "$main_path" "Prune stale linked-worktree metadata" 0 "$main_path" "$stale_refs"
    fi
  fi
}

discover_worktrees() {
  local root dotgit repo common raw_common
  local -a seen_common=()
  for root in "${SCAN_ROOTS[@]}"; do
    if [[ ! -d "$root" ]]; then
      progress_status "Skipping unavailable scan root: $root"
      continue
    fi
    progress_status "Scanning root: $root"
    while IFS= read -r dotgit; do
      repo=${dotgit%/.git}
      progress_status "Inspecting repository: $repo"
      raw_common=$(cd "$repo" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null) || continue
      if [[ "$raw_common" == /* ]]; then
        common="$raw_common"
      else
        common=$(cd "$repo" && cd "$raw_common" 2>/dev/null && pwd -P) || continue
      fi
      if (( ${#seen_common[@]} > 0 )) && contains_value "$common" "${seen_common[@]}"; then
        continue
      fi
      seen_common+=("$common")
      discover_worktrees_from_repo "$repo"
    done < <(find "$root" \
      \( -name node_modules -o -name .cache -o -name Library \) -prune -o \
      -name .git -print -prune 2>/dev/null)
  done
}

delete_temporary_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 0
  find "$path" -delete >/dev/null 2>&1 || true
}

project_path_is_dependency_data() {
  local relative="$1"
  case "/$relative/" in
    */node_modules/*|*/vendor/*|*/bower_components/*|*/.conda/*|*/.venv/*|*/venv/*|*/site-packages/*|*/Pods/*|*/.git/*)
      return 0
      ;;
  esac
  return 1
}

file_mtime_epoch() {
  local path="$1" value
  value=$(stat -f '%m' "$path" 2>/dev/null) || return 1
  [[ "$value" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$value"
}

project_activity_epoch() {
  local project="$1" list_file index_path relative full_path mtime newest=0 seen=0
  list_file=$(mktemp "${TMPDIR:-/tmp}/agent-junk-clean-files.XXXXXX") || return 1
  if ! GIT_OPTIONAL_LOCKS=0 git -C "$project" ls-files -z --cached --others --exclude-standard > "$list_file" 2>/dev/null; then
    delete_temporary_file "$list_file"
    return 1
  fi

  index_path=$(git -C "$project" rev-parse --git-path index 2>/dev/null) || {
    delete_temporary_file "$list_file"
    return 1
  }
  [[ "$index_path" == /* ]] || index_path="$project/$index_path"
  if [[ -f "$index_path" ]]; then
    mtime=$(file_mtime_epoch "$index_path") || {
      delete_temporary_file "$list_file"
      return 1
    }
    newest=$mtime
    seen=1
  fi

  while IFS= read -r -d '' relative; do
    [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* ]] || {
      delete_temporary_file "$list_file"
      return 1
    }
    project_path_is_dependency_data "$relative" && continue
    full_path="$project/$relative"
    [[ -e "$full_path" || -L "$full_path" ]] || continue
    mtime=$(file_mtime_epoch "$full_path") || {
      delete_temporary_file "$list_file"
      return 1
    }
    (( mtime > newest )) && newest=$mtime
    seen=1
  done < "$list_file"
  delete_temporary_file "$list_file"
  (( seen == 1 )) || return 1
  printf '%s' "$newest"
}

discover_project_node_modules_paths() {
  local project="$1" list_file path resolved owner output=""
  list_file=$(mktemp "${TMPDIR:-/tmp}/agent-junk-clean-node-modules.XXXXXX") || return 2
  if ! find "$project" \
    \( -name .git -o -name vendor -o -name bower_components -o -name .conda -o -name .venv -o -name venv -o -name site-packages -o -name Pods \) -prune -o \
    -name node_modules -print0 -prune > "$list_file" 2>/dev/null; then
    delete_temporary_file "$list_file"
    return 2
  fi

  while IFS= read -r -d '' path; do
    [[ "$path" != *$'\n'* && "$path" != *$'\r'* && -d "$path" && ! -L "$path" ]] || {
      delete_temporary_file "$list_file"
      return 2
    }
    resolved=$(cd "$path" && pwd -P) || {
      delete_temporary_file "$list_file"
      return 2
    }
    [[ "$resolved" == "$path" && "$path" == "$project"/* && "${path##*/}" == "node_modules" ]] || {
      delete_temporary_file "$list_file"
      return 2
    }
    owner=$(git -C "${path%/node_modules}" rev-parse --show-toplevel 2>/dev/null) || {
      delete_temporary_file "$list_file"
      return 2
    }
    owner=$(cd "$owner" && pwd -P) || {
      delete_temporary_file "$list_file"
      return 2
    }
    [[ "$owner" == "$project" ]] || continue
    output="${output}${output:+$'\n'}$path"
  done < "$list_file"
  delete_temporary_file "$list_file"
  [[ -n "$output" ]] || return 1
  printf '%s\n' "$output" | LC_ALL=C sort
}

node_modules_paths_are_untracked() {
  local project="$1" paths="$2" path relative tracked
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    relative=${path#"$project"/}
    tracked=$(git -C "$project" ls-files -- "$relative" 2>/dev/null) || return 1
    [[ -z "$tracked" ]] || return 1
  done <<< "$paths"
}

node_modules_group_size_kb() {
  local paths="$1" path size total=0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    size=$(path_size_kb "$path") || return 1
    total=$((total + size))
  done <<< "$paths"
  printf '%s' "$total"
}

inspect_node_modules_project() {
  local project="$1" paths path_status activity now age activity_date size count head
  progress_status "Discovering node_modules in project: $project"
  if paths=$(discover_project_node_modules_paths "$project"); then
    :
  else
    path_status=$?
    if (( path_status == 2 )); then
      add_protected "node_modules group — $project" "node_modules paths or Git ownership could not be verified"
    fi
    return 0
  fi

  count=$(printf '%s\n' "$paths" | awk 'NF { count++ } END { print count + 0 }')
  progress_status "Checking node_modules group ($count paths): $project"

  if [[ "$CURRENT_PWD" == "$project" || "$CURRENT_PWD" == "$project"/* ]]; then
    add_protected "node_modules group — $project" "the current shell working directory is inside this project"
    return 0
  fi

  GIT_OPTIONAL_LOCKS=0 git -C "$project" status --porcelain --untracked-files=all >/dev/null 2>&1 || {
    add_protected "node_modules group — $project" "Git status could not be verified"
    return 0
  }

  if ! node_modules_paths_are_untracked "$project" "$paths"; then
    add_protected "node_modules group — $project" "Git path verification failed or files under node_modules are tracked"
    return 0
  fi

  if path_is_active "$project" "node_modules project"; then
    path_status=0
  else
    path_status=$?
  fi
  if (( path_status == 0 )); then
    add_protected "node_modules group — $project" "an active process references the project or its node_modules"
    return 0
  elif (( path_status == 2 )); then
    add_protected "node_modules group — $project" "active project state could not be verified (lsof or ps unavailable)"
    return 0
  fi

  progress_status "Calculating project activity: $project"
  activity=$(project_activity_epoch "$project") || {
    add_protected "node_modules group — $project" "project activity could not be established"
    return 0
  }
  now=$(date +%s)
  if (( activity > now )); then
    age=0
  else
    age=$(((now - activity) / 86400))
  fi
  if (( age < OLDER_THAN_DAYS )); then
    progress_status "Keeping recent node_modules (${age}d < ${OLDER_THAN_DAYS}d): $project"
    return 0
  fi

  size=$(node_modules_group_size_kb "$paths") || {
    add_protected "node_modules group — $project" "combined node_modules size could not be measured"
    return 0
  }
  (( size > 0 )) || return 0
  activity_date=$(date -r "$activity" '+%Y-%m-%d' 2>/dev/null) || {
    add_protected "node_modules group — $project" "project activity date could not be formatted"
    return 0
  }
  head=$(git -C "$project" rev-parse --verify HEAD 2>/dev/null) || {
    add_protected "node_modules group — $project" "project HEAD could not be verified"
    return 0
  }
  add_candidate "node-modules" "$project" "Inactive node_modules group" "$size" "$project" "$paths" "$head" "$count" "$activity" "$activity_date" "$age"
}

discover_node_modules() {
  local scan_root dotgit project
  local -a seen_projects=()
  progress_status "Discovering Git projects with node_modules (threshold: ${OLDER_THAN_DAYS}d)"
  for scan_root in "${SCAN_ROOTS[@]}"; do
    [[ -d "$scan_root" ]] || continue
    progress_status "Scanning projects for node_modules: $scan_root"
    while IFS= read -r dotgit; do
      project=${dotgit%/.git}
      project=$(git -C "$project" rev-parse --show-toplevel 2>/dev/null) || continue
      project=$(cd "$project" && pwd -P) || continue
      [[ "$project" == "$scan_root" || "$project" == "$scan_root"/* ]] || continue
      if (( ${#seen_projects[@]} > 0 )) && contains_value "$project" "${seen_projects[@]}"; then
        continue
      fi
      seen_projects+=("$project")
      inspect_node_modules_project "$project"
    done < <(find "$scan_root" \
      \( -name node_modules -o -name vendor -o -name bower_components -o -name .conda -o -name .venv -o -name venv -o -name site-packages -o -name Pods \) -prune -o \
      -name .git -print -prune 2>/dev/null)
  done
}

discover_caches() {
  local child store_path size ref_status process_status

  progress_status "Checking known renewable caches under $CLEAN_HOME"

  if [[ -d "$CLEAN_HOME/.npm/_npx" ]]; then
    while IFS= read -r child; do
      add_cache_if_safe "npx" "$child" "npx installation"
    done < <(find "$CLEAN_HOME/.npm/_npx" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null)
  fi

  add_cache_if_safe "npm" "$CLEAN_HOME/.npm/_cacache" "npm content cache" '(^|/)(npm|npx)( |$)|npm-cli\.js|npx-cli\.js'
  add_cache_if_safe "pnpm-cache" "$CLEAN_HOME/Library/Caches/pnpm" "pnpm cache" '(^|/)(pnpm)( |$)|pnpm\.c?js'
  add_cache_if_safe "pnpm-cache" "$CLEAN_HOME/.cache/pnpm" "pnpm cache" '(^|/)(pnpm)( |$)|pnpm\.c?js'
  add_cache_if_safe "yarn" "$CLEAN_HOME/Library/Caches/Yarn" "Yarn cache" '(^|/)(yarn)( |$)|yarn\.c?js'
  add_cache_if_safe "yarn" "$CLEAN_HOME/.cache/yarn" "Yarn cache" '(^|/)(yarn)( |$)|yarn\.c?js'
  add_cache_if_safe "yarn" "$CLEAN_HOME/.yarn/berry/cache" "Yarn Berry cache" '(^|/)(yarn)( |$)|yarn\.c?js'
  add_cache_if_safe "playwright" "$CLEAN_HOME/Library/Caches/ms-playwright" "Playwright browser cache" 'playwright|ms-playwright'
  add_cache_if_safe "playwright" "$CLEAN_HOME/.cache/ms-playwright" "Playwright browser cache" 'playwright|ms-playwright'
  add_cache_if_safe "typescript" "$CLEAN_HOME/Library/Caches/typescript" "TypeScript cache" '(^|/)(tsc|tsserver)( |$)|typescript/lib'
  add_cache_if_safe "typescript" "$CLEAN_HOME/.cache/typescript" "TypeScript cache" '(^|/)(tsc|tsserver)( |$)|typescript/lib'
  add_cache_if_safe "node-gyp" "$CLEAN_HOME/Library/Caches/node-gyp" "node-gyp cache" 'node-gyp'
  add_cache_if_safe "node-gyp" "$CLEAN_HOME/.cache/node-gyp" "node-gyp cache" 'node-gyp'
  add_cache_if_safe "dotslash" "$CLEAN_HOME/Library/Caches/dotslash" "Dotslash cache" '(^|/)(dotslash)( |$)'
  add_cache_if_safe "dotslash" "$CLEAN_HOME/Library/Caches/com.facebook.dotslash" "Dotslash cache" '(^|/)(dotslash)( |$)'
  add_cache_if_safe "dotslash" "$CLEAN_HOME/.cache/dotslash" "Dotslash cache" '(^|/)(dotslash)( |$)'
  add_cache_if_safe "bun" "$CLEAN_HOME/.bun/install/cache" "Bun install cache" '(^|/)(bun|bunx)( |$)'
  add_cache_if_safe "bun" "$CLEAN_HOME/Library/Caches/bun" "Bun cache" '(^|/)(bun|bunx)( |$)'
  add_cache_if_safe "bun" "$CLEAN_HOME/.cache/bun" "Bun cache" '(^|/)(bun|bunx)( |$)'
  add_cache_if_safe "puppeteer" "$CLEAN_HOME/.cache/puppeteer" "Puppeteer cache" 'puppeteer'
  add_cache_if_safe "puppeteer" "$CLEAN_HOME/Library/Caches/puppeteer" "Puppeteer cache" 'puppeteer'
  add_cache_if_safe "cypress" "$CLEAN_HOME/Library/Caches/Cypress" "Cypress cache" '(^|/)(Cypress|cypress)( |$)|Cypress\.app'
  add_cache_if_safe "cypress" "$CLEAN_HOME/.cache/Cypress" "Cypress cache" '(^|/)(Cypress|cypress)( |$)|Cypress\.app'
  add_cache_if_safe "turbo" "$CLEAN_HOME/.cache/turbo" "Turbo cache" '(^|/)(turbo)( |$)|turbo\.c?js'
  add_cache_if_safe "turbo" "$CLEAN_HOME/Library/Caches/turbo" "Turbo cache" '(^|/)(turbo)( |$)|turbo\.c?js'
  add_cache_if_safe "corepack" "$CLEAN_HOME/Library/Caches/node/corepack" "Corepack cache" '(^|/)(corepack)( |$)|corepack\.c?js'
  add_cache_if_safe "corepack" "$CLEAN_HOME/Library/Caches/corepack" "Corepack cache" '(^|/)(corepack)( |$)|corepack\.c?js'
  add_cache_if_safe "corepack" "$CLEAN_HOME/.cache/node/corepack" "Corepack cache" '(^|/)(corepack)( |$)|corepack\.c?js'

  if command -v pnpm >/dev/null 2>&1; then
    progress_status "Checking pnpm store location"
    if process_pattern_active '(^|/)(pnpm)( |$)|pnpm\.c?js'; then
      process_status=0
    else
      process_status=$?
    fi
    if (( process_status == 0 )); then
      add_protected "pnpm store" "a pnpm process is running"
    elif (( process_status == 2 )); then
      add_protected "pnpm store" "active-process state could not be verified (pgrep unavailable)"
    else
      store_path=$(pnpm store path 2>/dev/null) || store_path=""
      if [[ -n "$store_path" && "$store_path" == "$CLEAN_HOME"/* && -d "$store_path" && ! -L "$store_path" ]]; then
        store_path=$(cd "$store_path" && pwd -P) || store_path=""
      else
        store_path=""
      fi
      if [[ -n "$store_path" ]]; then
        if path_is_active "$store_path" "pnpm store"; then
          ref_status=0
        else
          ref_status=$?
        fi
        if (( ref_status == 0 )); then
          add_protected "pnpm store — $store_path" "an active process references this path"
        elif (( ref_status == 2 )); then
          add_protected "pnpm store — $store_path" "active-path state could not be verified (lsof or ps unavailable)"
        else
          size=$(path_size_kb "$store_path") || size=0
          if (( size > 0 )); then
            add_candidate "pnpm-store" "$store_path" "pnpm store prune" "$size"
          fi
        fi
      fi
    fi
  fi
}

print_audit() {
  local i
  printf '\n%sProtected / not selectable%s\n' "$BOLD" "$RESET"
  if (( ${#PROTECTED_LABEL[@]} == 0 )); then
    printf '  none found\n'
  else
    for ((i = 0; i < ${#PROTECTED_LABEL[@]}; i++)); do
      printf '  - %s\n    %s\n' "${PROTECTED_LABEL[$i]}" "${PROTECTED_REASON[$i]}"
    done
  fi

  printf '\n%sSafe candidates%s\n' "$BOLD" "$RESET"
  if (( ${#CANDIDATE_PATH[@]} == 0 )); then
    printf '  none found\n'
  else
    for ((i = 0; i < ${#CANDIDATE_PATH[@]}; i++)); do
      if [[ "${CANDIDATE_KIND[$i]}" == "node-modules" ]]; then
        printf '  [%d] %s — %s current size / reclaim upper bound\n      Project: %s\n      %s node_modules path(s); last measured activity: %s (%s days ago)\n' \
          "$((i + 1))" "${CANDIDATE_LABEL[$i]}" "$(format_size "${CANDIDATE_SIZE_KB[$i]}")" "${CANDIDATE_PATH[$i]}" \
          "${CANDIDATE_COUNT[$i]}" "${CANDIDATE_ACTIVITY_DATE[$i]}" "${CANDIDATE_AGE_DAYS[$i]}"
      elif [[ "${CANDIDATE_KIND[$i]}" == "worktree-prune" ]]; then
        printf '  [%d] %s — metadata only\n      Repository: %s\n' "$((i + 1))" "${CANDIDATE_LABEL[$i]}" "${CANDIDATE_PATH[$i]}"
      elif [[ "${CANDIDATE_KIND[$i]}" == "pnpm-store" ]]; then
        printf '  [%d] %s — %s current store size; actual reclaim may be lower\n      %s\n' "$((i + 1))" "${CANDIDATE_LABEL[$i]}" "$(format_size "${CANDIDATE_SIZE_KB[$i]}")" "${CANDIDATE_PATH[$i]}"
      else
        printf '  [%d] %s — %s\n      %s\n' "$((i + 1))" "${CANDIDATE_LABEL[$i]}" "$(format_size "${CANDIDATE_SIZE_KB[$i]}")" "${CANDIDATE_PATH[$i]}"
      fi
    done
  fi
}

machine_emit_result() {
  local key="$1" status="$2" label="$3" path="$4" detail="$5"
  printf 'RESULT\t%s\t%s\t%s\t%s\t%s\n' \
    "$key" "$status" "$(machine_base64 "$label")" "$(machine_base64 "$path")" "$(machine_base64 "$detail")"
}

machine_emit_if_applying() {
