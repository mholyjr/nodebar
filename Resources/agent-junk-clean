    "$CLEAN_HOME/.cache/typescript" \
    "$CLEAN_HOME/Library/Caches/node-gyp" \
    "$CLEAN_HOME/.cache/node-gyp" \
    "$CLEAN_HOME/Library/Caches/dotslash" \
    "$CLEAN_HOME/Library/Caches/com.facebook.dotslash" \
    "$CLEAN_HOME/.cache/dotslash" \
    "$CLEAN_HOME/.bun/install/cache" \
