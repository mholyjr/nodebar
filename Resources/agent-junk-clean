delete_exact_directory() {
  local path="$1"
  validate_cache_path "$path" || return 1
  find "$path" -depth -delete
  [[ ! -e "$path" ]]
}

revalidate_cache_candidate() {
  local kind="$1" path="$2" process_pattern="" status
  validate_cache_path "$path" || return 1
  case "$kind" in
    npm) process_pattern='(^|/)(npm|npx)( |$)|npm-cli\.js|npx-cli\.js' ;;
    pnpm-cache) process_pattern='(^|/)(pnpm)( |$)|pnpm\.c?js' ;;
    yarn) process_pattern='(^|/)(yarn)( |$)|yarn\.c?js' ;;
    playwright) process_pattern='playwright|ms-playwright' ;;
    typescript) process_pattern='(^|/)(tsc|tsserver)( |$)|typescript/lib' ;;
    node-gyp) process_pattern='node-gyp' ;;
    dotslash) process_pattern='(^|/)(dotslash)( |$)' ;;
    bun) process_pattern='(^|/)(bun|bunx)( |$)' ;;
    puppeteer) process_pattern='puppeteer' ;;
    cypress) process_pattern='(^|/)(Cypress|cypress)( |$)|Cypress\.app' ;;
    turbo) process_pattern='(^|/)(turbo)( |$)|turbo\.c?js' ;;
    corepack) process_pattern='(^|/)(corepack)( |$)|corepack\.c?js' ;;
  esac
  if [[ -n "$process_pattern" ]]; then
    if process_pattern_active "$process_pattern"; then
      status=0
    else
      status=$?
    fi
    (( status == 1 )) || return 1
  fi
  if path_is_active "$path" "$kind cache"; then
    status=0
  else
    status=$?
  fi
  (( status == 1 ))
}

execute_worktree() {
  local index="$1" path repo ref expected current status_output ref_status
  path=${CANDIDATE_PATH[$index]}
  repo=${CANDIDATE_REPO[$index]}
  ref=${CANDIDATE_REF[$index]}
  expected=${CANDIDATE_OID[$index]}

  [[ -d "$path" && -e "$path/.git" && "$ref" == refs/heads/* ]] || return 2
  current=$(git -C "$repo" rev-parse --verify "$ref" 2>/dev/null) || return 2
  [[ "$current" == "$expected" ]] || return 2
  status_output=$(GIT_OPTIONAL_LOCKS=0 git -C "$path" status --porcelain --untracked-files=all 2>/dev/null) || return 2
  [[ -z "$status_output" ]] || return 2
  if path_is_active "$path" "linked worktree"; then
    ref_status=0
  else
    ref_status=$?
  fi
  (( ref_status == 1 )) || return 2

  if ! git -C "$repo" worktree remove "$path" >&2; then
    return 1
  fi
  [[ ! -e "$path" ]] || return 1
  current=$(git -C "$repo" rev-parse --verify "$ref" 2>/dev/null) || return 1
  [[ "$current" == "$expected" ]] || return 1
  return 0
}

execute_worktree_prune() {
  local index="$1" repo snapshot stale_status
  repo=${CANDIDATE_REPO[$index]}
  snapshot=${CANDIDATE_REF[$index]}

  [[ -d "$repo" && -e "$repo/.git" ]] || return 2
  stale_metadata_is_safe_to_prune "$repo" || return 2
  verify_ref_snapshot "$repo" "$snapshot" || return 2
  git -C "$repo" worktree prune >&2 || return 1
  verify_ref_snapshot "$repo" "$snapshot" || return 1
  if repo_has_stale_metadata "$repo"; then
    stale_status=0
  else
    stale_status=$?
  fi
  (( stale_status == 1 )) || return 1
  return 0
}

validate_node_modules_path() {
  local project="$1" path="$2" resolved owner
  [[ "$path" != *$'\n'* && "$path" != *$'\r'* && -d "$path" && ! -L "$path" ]] || return 1
  resolved=$(cd "$path" && pwd -P) || return 1
  [[ "$resolved" == "$path" && "$path" == "$project"/* && "${path##*/}" == "node_modules" ]] || return 1
  owner=$(git -C "${path%/node_modules}" rev-parse --show-toplevel 2>/dev/null) || return 1
  owner=$(cd "$owner" && pwd -P) || return 1
  [[ "$owner" == "$project" ]]
}

revalidate_node_modules_group() {
  local index="$1" project expected_paths current_paths expected_head current_head current_pwd status activity now age size active_status count
  project=${CANDIDATE_PATH[$index]}
  expected_paths=${CANDIDATE_REF[$index]}
  expected_head=${CANDIDATE_OID[$index]}

  [[ -d "$project" && -e "$project/.git" ]] || return 2
  current_pwd=$(pwd -P) || return 2
  [[ "$current_pwd" != "$project" && "$current_pwd" != "$project"/* ]] || return 2
  current_head=$(git -C "$project" rev-parse --verify HEAD 2>/dev/null) || return 2
  [[ "$current_head" == "$expected_head" ]] || return 2
  GIT_OPTIONAL_LOCKS=0 git -C "$project" status --porcelain --untracked-files=all >/dev/null 2>&1 || return 2

  current_paths=$(discover_project_node_modules_paths "$project") || return 2
  [[ "$current_paths" == "$expected_paths" ]] || return 2
  count=$(printf '%s\n' "$current_paths" | awk 'NF { count++ } END { print count + 0 }')
  [[ "$count" == "${CANDIDATE_COUNT[$index]}" ]] || return 2
  node_modules_paths_are_untracked "$project" "$current_paths" || return 2

  if path_is_active "$project" "node_modules project"; then
    active_status=0
  else
    active_status=$?
  fi
  (( active_status == 1 )) || return 2

  progress_status "Recalculating project activity: $project"
  activity=$(project_activity_epoch "$project") || return 2
  now=$(date +%s)
  if (( activity > now )); then age=0; else age=$(((now - activity) / 86400)); fi
  (( age >= OLDER_THAN_DAYS )) || return 2
  size=$(node_modules_group_size_kb "$current_paths") || return 2
  (( size > 0 )) || return 2
  return 0
}

delete_node_modules_group() {
  local index="$1" project paths expected_head path active_status removed=0 failures="" current_head
  project=${CANDIDATE_PATH[$index]}
  paths=${CANDIDATE_REF[$index]}
  expected_head=${CANDIDATE_OID[$index]}
  LAST_NODE_DELETE_RESULT=""

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if ! validate_node_modules_path "$project" "$path"; then
      failures="${failures}${failures:+; }validation changed before deletion: $path"
      continue
    fi
    if path_is_active "$project" "node_modules project"; then
      active_status=0
    else
      active_status=$?
    fi
    if (( active_status != 1 )); then
      failures="${failures}${failures:+; }project became active before deleting: $path"
      continue
    fi
    progress_status "Deleting node_modules: $path"
    if find "$path" -depth -delete && [[ ! -e "$path" ]]; then
      removed=$((removed + 1))
    else
      failures="${failures}${failures:+; }deletion failed or path remained: $path"
    fi
  done <<< "$paths"

  current_head=$(git -C "$project" rev-parse --verify HEAD 2>/dev/null) || current_head=""
  if [[ "$current_head" != "$expected_head" ]]; then
    failures="${failures}${failures:+; }project HEAD changed during deletion: $project"
  fi
  LAST_NODE_DELETE_RESULT="removed $removed/${CANDIDATE_COUNT[$index]} path(s)${failures:+; $failures}"
  [[ -z "$failures" && "$removed" == "${CANDIDATE_COUNT[$index]}" ]]
}

execute_pnpm_store() {
  local path="$1" current status
  command -v pnpm >/dev/null 2>&1 || return 2
  if process_pattern_active '(^|/)(pnpm)( |$)|pnpm\.c?js'; then
    status=0
  else
    status=$?
  fi
  (( status == 1 )) || return 2
  current=$(pnpm store path 2>/dev/null) || return 2
  [[ "$current" == "$path" && "$current" == "$CLEAN_HOME"/* && -d "$current" && ! -L "$current" ]] || return 2
  if path_is_active "$current" "pnpm store"; then
    status=0
  else
    status=$?
  fi
  (( status == 1 )) || return 2
  pnpm store prune >&2
}

execute_selected() {
  local i kind path result repo prune_repo stale_status key
  local -a repos_to_prune=()
  EXECUTION_STARTED=1
  for ((i = 0; i < ${#CANDIDATE_PATH[@]}; i++)); do
    (( CANDIDATE_SELECTED[$i] == 1 )) || continue
    kind=${CANDIDATE_KIND[$i]}
    path=${CANDIDATE_PATH[$i]}
    key=""
    if [[ "$MACHINE_MODE" == "apply" ]]; then
      key=$(candidate_key "$i" 2>/dev/null) || key=""
      if [[ -z "$key" || "$key" != "${CANDIDATE_EXPECTED_KEY[$i]}" ]]; then
        SKIPPED_ITEMS+=("${CANDIDATE_LABEL[$i]} — state changed or could not be revalidated: $path")
        machine_emit_result "${CANDIDATE_EXPECTED_KEY[$i]}" "skipped" "${CANDIDATE_LABEL[$i]}" "$path" "The candidate changed after the fresh audit."
        continue
      fi
    fi
    result=0
    if [[ "$kind" == "worktree" ]]; then
      execute_worktree "$i" || result=$?
      if (( result == 0 )); then
        SUCCEEDED+=("${CANDIDATE_LABEL[$i]} — $path")
        machine_emit_if_applying "$key" "succeeded" "${CANDIDATE_LABEL[$i]}" "$path" "Removed the linked worktree."
        repo=${CANDIDATE_REPO[$i]}
        if (( ${#repos_to_prune[@]} == 0 )) || ! contains_value "$repo" "${repos_to_prune[@]}"; then
          repos_to_prune+=("$repo")
        fi
      elif (( result == 2 )); then
        SKIPPED_ITEMS+=("${CANDIDATE_LABEL[$i]} — state changed or could not be revalidated: $path")
        machine_emit_if_applying "$key" "skipped" "${CANDIDATE_LABEL[$i]}" "$path" "State changed or could not be revalidated."
      else
        FAILED+=("${CANDIDATE_LABEL[$i]} — git worktree remove failed: $path")
        machine_emit_if_applying "$key" "failed" "${CANDIDATE_LABEL[$i]}" "$path" "Git worktree removal failed."
      fi
    elif [[ "$kind" == "node-modules" ]]; then
      if ! revalidate_node_modules_group "$i"; then
        SKIPPED_ITEMS+=("${CANDIDATE_LABEL[$i]} — project state, activity, membership, or process use changed: $path")
        machine_emit_if_applying "$key" "skipped" "${CANDIDATE_LABEL[$i]}" "$path" "Project state, activity, membership, or process use changed."
      elif delete_node_modules_group "$i"; then
        SUCCEEDED+=("${CANDIDATE_LABEL[$i]} — removed ${CANDIDATE_COUNT[$i]} path(s): $path")
        machine_emit_if_applying "$key" "succeeded" "${CANDIDATE_LABEL[$i]}" "$path" "Removed ${CANDIDATE_COUNT[$i]} node_modules path(s)."
      else
        FAILED+=("${CANDIDATE_LABEL[$i]} — $LAST_NODE_DELETE_RESULT — $path")
        machine_emit_if_applying "$key" "failed" "${CANDIDATE_LABEL[$i]}" "$path" "$LAST_NODE_DELETE_RESULT"
      fi
    elif [[ "$kind" == "worktree-prune" ]]; then
      execute_worktree_prune "$i" || result=$?
      if (( result == 0 )); then
        SUCCEEDED+=("${CANDIDATE_LABEL[$i]} — ${CANDIDATE_REPO[$i]}")
        machine_emit_if_applying "$key" "succeeded" "${CANDIDATE_LABEL[$i]}" "${CANDIDATE_REPO[$i]}" "Pruned stale linked-worktree metadata."
      elif (( result == 2 )); then
        SKIPPED_ITEMS+=("${CANDIDATE_LABEL[$i]} — stale metadata changed or could not be safely revalidated: ${CANDIDATE_REPO[$i]}")
        machine_emit_if_applying "$key" "skipped" "${CANDIDATE_LABEL[$i]}" "${CANDIDATE_REPO[$i]}" "Stale metadata changed or could not be safely revalidated."
      else
        FAILED+=("${CANDIDATE_LABEL[$i]} — git worktree prune failed or verification found remaining stale metadata: ${CANDIDATE_REPO[$i]}")
        machine_emit_if_applying "$key" "failed" "${CANDIDATE_LABEL[$i]}" "${CANDIDATE_REPO[$i]}" "Git worktree prune failed or remaining metadata was found."
      fi
    elif [[ "$kind" == "pnpm-store" ]]; then
      execute_pnpm_store "$path" || result=$?
      if (( result == 0 )); then
        SUCCEEDED+=("${CANDIDATE_LABEL[$i]} — $path")
        machine_emit_if_applying "$key" "succeeded" "${CANDIDATE_LABEL[$i]}" "$path" "Pruned the pnpm store."
      elif (( result == 2 )); then
        SKIPPED_ITEMS+=("${CANDIDATE_LABEL[$i]} — state changed or could not be revalidated: $path")
        machine_emit_if_applying "$key" "skipped" "${CANDIDATE_LABEL[$i]}" "$path" "State changed or could not be revalidated."
      else
        FAILED+=("${CANDIDATE_LABEL[$i]} — pnpm store prune failed: $path")
        machine_emit_if_applying "$key" "failed" "${CANDIDATE_LABEL[$i]}" "$path" "pnpm store prune failed."
      fi
    else
      if ! revalidate_cache_candidate "$kind" "$path"; then
        SKIPPED_ITEMS+=("${CANDIDATE_LABEL[$i]} — state changed or could not be revalidated: $path")
        machine_emit_if_applying "$key" "skipped" "${CANDIDATE_LABEL[$i]}" "$path" "State changed or could not be revalidated."
      elif delete_exact_directory "$path"; then
        SUCCEEDED+=("${CANDIDATE_LABEL[$i]} — $path")
        machine_emit_if_applying "$key" "succeeded" "${CANDIDATE_LABEL[$i]}" "$path" "Deleted the validated cache directory."
      else
        FAILED+=("${CANDIDATE_LABEL[$i]} — deletion failed: $path")
        machine_emit_if_applying "$key" "failed" "${CANDIDATE_LABEL[$i]}" "$path" "Validated deletion failed."
      fi
    fi
  done

  if (( ${#repos_to_prune[@]} > 0 )); then
    for prune_repo in "${repos_to_prune[@]}"; do
      if repo_has_stale_metadata "$prune_repo"; then
        stale_status=0
      else
        stale_status=$?
      fi
      if (( stale_status == 0 )); then
        SKIPPED_ITEMS+=("Git worktree prune not run because separate stale metadata was not selected or could not be pruned safely — $prune_repo")
        machine_emit_if_applying "$(machine_auxiliary_key "worktree-prune" "$prune_repo")" "skipped" "Git worktree prune" "$prune_repo" "Separate stale metadata was not selected or could not be pruned safely."
      elif (( stale_status == 2 )); then
        FAILED+=("Git worktree prune not run because repository metadata could not be revalidated — $prune_repo")
        machine_emit_if_applying "$(machine_auxiliary_key "worktree-prune" "$prune_repo")" "failed" "Git worktree prune" "$prune_repo" "Repository metadata could not be revalidated."
      elif ! git -C "$prune_repo" worktree prune >&2; then
        FAILED+=("Git worktree prune failed — $prune_repo")
        machine_emit_if_applying "$(machine_auxiliary_key "worktree-prune" "$prune_repo")" "failed" "Git worktree prune" "$prune_repo" "Git worktree prune failed."
      fi
    done
  fi
  progress_end_line
}

print_result_group() {
  local title="$1"
  shift
  printf '\n%s%s%s\n' "$BOLD" "$title" "$RESET"
  if (( $# == 0 )); then
    printf '  none\n'
  else
    local item
    for item in "$@"; do printf '  - %s\n' "$item"; done
  fi
}

run_audit() {
  local started_at finished_at elapsed
  started_at=$(date +%s)
  progress_status "Starting audit"
  discover_worktrees
  discover_node_modules
  discover_caches
  finished_at=$(date +%s)
  elapsed=$((finished_at - started_at))
  progress_complete "Audit complete in ${elapsed}s"
}

if [[ "$MACHINE_MODE" == "scan" ]]; then
  run_audit
  machine_print_audit
  exit 0
fi

if [[ "$MACHINE_MODE" == "apply" ]]; then
  run_audit
  printf 'HEADER\tAGENT_JUNK_CLEAN_V1\n'
  machine_select_candidates
  execute_selected
  machine_print_apply_summary
  if (( ${#FAILED[@]} > 0 )); then
    exit 1
  fi
  exit 0
fi

if (( DRY_RUN == 1 )); then
  printf '%s: dry run; no files will be removed.\n' "$PROGRAM_NAME"
  run_audit
  print_audit
  printf '\nNo changes made. All listed caches are renewable; no container runtime was queried.\n'
  exit 0
fi

stage "Audit" 1
say "Scanning linked Git worktrees and known renewable developer caches."
say "Primary worktrees, active/dirty paths, project dependencies, and Codex data stay protected."
run_audit
print_audit

if (( ${#CANDIDATE_PATH[@]} == 0 )); then
  printf '\nNothing safe to delete. No changes made.\n'
  exit 0
fi

pause "Press Enter to open the checklist."
stage "Choose" 1
run_checklist
if (( $(selected_count) == 0 )); then
  printf '\nNothing selected. No changes made.\n'
  exit 0
fi
print_selected

printf '\nThese directories are deleted permanently, not moved to Trash.\n'
printf 'Caches are renewable and will be downloaded again when needed.\n'
printf 'Type DELETE exactly to continue: '
confirmation=""
IFS= read -r confirmation || true
if [[ "$confirmation" != "DELETE" ]]; then
  printf 'Confirmation did not match. No changes made.\n'
  exit 0
fi

stage "Delete and verify" 1
before_free=$(free_space_kb || true)
execute_selected
after_free=$(free_space_kb || true)

printf '\n%sCleanup summary%s\n' "$BOLD" "$RESET"
if [[ "$before_free" =~ ^[0-9]+$ && "$after_free" =~ ^[0-9]+$ ]]; then
  printf '  Free space before: %s\n' "$(format_size "$before_free")"
  printf '  Free space after:  %s\n' "$(format_size "$after_free")"
  if (( after_free >= before_free )); then
    printf '  Space gained:      %s\n' "$(format_size "$((after_free - before_free))")"
  fi
else
  printf '  Free-space measurement was unavailable.\n'
fi

if (( ${#SUCCEEDED[@]} > 0 )); then
  print_result_group "Deleted / pruned" "${SUCCEEDED[@]}"
else
  print_result_group "Deleted / pruned"
fi
if (( ${#SKIPPED_ITEMS[@]} > 0 )); then
  print_result_group "Skipped after revalidation" "${SKIPPED_ITEMS[@]}"
else
  print_result_group "Skipped after revalidation"
fi
if (( ${#FAILED[@]} > 0 )); then
  print_result_group "Failures" "${FAILED[@]}"
else
  print_result_group "Failures"
fi

printf '\nDeleted directories are not in Trash. Renewable caches will be downloaded again when needed.\n'
if (( ${#FAILED[@]} > 0 )); then
  exit 1
fi
