  printf 'SUMMARY\t%d\t%d\t%d\n' "$emitted" "$protected" "$total"
}

machine_select_candidates() {
  local i requested key found
  for ((i = 0; i < ${#CANDIDATE_SELECTED[@]}; i++)); do
    CANDIDATE_SELECTED[$i]=0
    CANDIDATE_EXPECTED_KEY[$i]=""
  done
  for requested in "${MACHINE_KEYS[@]}"; do
    found=0
    for ((i = 0; i < ${#CANDIDATE_PATH[@]}; i++)); do
      key=$(candidate_key "$i" 2>/dev/null) || continue
      if [[ "$key" == "$requested" ]]; then
        CANDIDATE_SELECTED[$i]=1
        CANDIDATE_EXPECTED_KEY[$i]="$requested"
        found=1
        break
      fi
    done
    if (( found == 0 )); then
      machine_emit_result "$requested" "skipped" "" "" "The candidate was missing or changed after the preview."
      SKIPPED_ITEMS+=("Candidate was missing or changed after the preview: $requested")
    fi
  done
}

machine_print_apply_summary() {
