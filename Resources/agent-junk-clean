}

draw_checklist() {
  local cursor="$1" i marker pointer
  printf '\033[H\033[2J'
  printf '%sChoose what to delete%s\n' "$BOLD" "$RESET"
  printf 'Up/Down move · Space toggles · Enter accepts · Ctrl-C cancels\n\n'
  for ((i = 0; i < ${#CANDIDATE_PATH[@]}; i++)); do
    marker=" "
    (( CANDIDATE_SELECTED[$i] == 1 )) && marker="x"
    pointer=" "
    (( i == cursor )) && pointer=">"
    if [[ "${CANDIDATE_KIND[$i]}" == "node-modules" ]]; then
      printf '%s [%s] %s — %s current size / reclaim upper bound\n    Project: %s\n    %s path(s); activity: %s (%sd ago)\n' \
        "$pointer" "$marker" "${CANDIDATE_LABEL[$i]}" "$(format_size "${CANDIDATE_SIZE_KB[$i]}")" "${CANDIDATE_PATH[$i]}" \
        "${CANDIDATE_COUNT[$i]}" "${CANDIDATE_ACTIVITY_DATE[$i]}" "${CANDIDATE_AGE_DAYS[$i]}"
    elif [[ "${CANDIDATE_KIND[$i]}" == "worktree-prune" ]]; then
      printf '%s [%s] %s — metadata only\n    Repository: %s\n' "$pointer" "$marker" "${CANDIDATE_LABEL[$i]}" "${CANDIDATE_PATH[$i]}"
    elif [[ "${CANDIDATE_KIND[$i]}" == "pnpm-store" ]]; then
      printf '%s [%s] %s — %s current store size (actual reclaim may be lower)\n    %s\n' "$pointer" "$marker" "${CANDIDATE_LABEL[$i]}" "$(format_size "${CANDIDATE_SIZE_KB[$i]}")" "${CANDIDATE_PATH[$i]}"
    else
      printf '%s [%s] %s — %s\n    %s\n' "$pointer" "$marker" "${CANDIDATE_LABEL[$i]}" "$(format_size "${CANDIDATE_SIZE_KB[$i]}")" "${CANDIDATE_PATH[$i]}"
    fi
  done
}

run_checklist() {
  local cursor=0 key rest count
  count=${#CANDIDATE_PATH[@]}
  (( count > 0 )) || return 0
  ORIGINAL_STTY=$(stty -g)
  stty -echo
  while :; do
    draw_checklist "$cursor"
    key=""
    IFS= read -rsn1 key || true
    case "$key" in
      "") break ;;
      " ")
        if (( CANDIDATE_SELECTED[$cursor] == 1 )); then
          CANDIDATE_SELECTED[$cursor]=0
        else
          CANDIDATE_SELECTED[$cursor]=1
        fi
        ;;
      $'\033')
        rest=""
        IFS= read -rsn2 -t 1 rest || true
        case "$rest" in
          '[A') (( cursor > 0 )) && cursor=$((cursor - 1)) ;;
          '[B') (( cursor < count - 1 )) && cursor=$((cursor + 1)) ;;
        esac
        ;;
    esac
  done
  cleanup_terminal
  ORIGINAL_STTY=""
  printf '\033[H\033[2J'
}

