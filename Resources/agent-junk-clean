format_size() {
  local kb="$1"
  awk -v kb="$kb" 'BEGIN {
    if (kb >= 1048576) printf "%.1f GiB", kb / 1048576;
    else if (kb >= 1024) printf "%.1f MiB", kb / 1024;
    else printf "%d KiB", kb;
  }'
}

path_size_kb() {
  local path="$1" size
  size=$(du -sk "$path" 2>/dev/null | awk 'NR == 1 { print $1 }') || return 1
  [[ "$size" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$size"
}

machine_base64() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

path_stat_snapshot() {
  local path="$1" metadata
  metadata=$(stat -f '%i:%m:%z' "$path" 2>/dev/null) || return 1
  [[ "$metadata" =~ ^[0-9]+:[0-9]+:[0-9]+$ ]] || return 1
  printf '%s' "$metadata"
}

candidate_stat_snapshot() {
  local kind="$1" path="$2" members="$3" member metadata snapshot=""
  metadata=$(path_stat_snapshot "$path") || return 1
  snapshot="$path:$metadata"
  if [[ "$kind" == "node-modules" ]]; then
    while IFS= read -r member; do
      [[ -n "$member" ]] || continue
      metadata=$(path_stat_snapshot "$member") || return 1
      snapshot="${snapshot}|${member}:${metadata}"
    done <<< "$members"
  fi
  printf '%s' "$snapshot"
}

candidate_key() {
  local index="$1" snapshot
  snapshot=$(candidate_stat_snapshot \
    "${CANDIDATE_KIND[$index]}" \
    "${CANDIDATE_PATH[$index]}" \
    "${CANDIDATE_REF[$index]}") || return 1
  {
    printf '%s\036' "${CANDIDATE_KIND[$index]}"
    printf '%s\036' "${CANDIDATE_PATH[$index]}"
    printf '%s\036' "${CANDIDATE_REPO[$index]}"
    printf '%s\036' "${CANDIDATE_REF[$index]}"
    printf '%s\036' "${CANDIDATE_OID[$index]}"
    printf '%s\036' "${CANDIDATE_ACTIVITY_EPOCH[$index]}"
    printf '%s\036' "${CANDIDATE_SIZE_KB[$index]}"
    printf '%s' "$snapshot"
  } | shasum -a 256 | awk '{ print $1 }'
}

free_space_kb() {
