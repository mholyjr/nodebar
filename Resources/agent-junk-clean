usage() {
  printf '%s\n' \
    'Usage: agent-junk-clean [--dry-run] [--older-than DAYS]' \
    '       agent-junk-clean --machine-scan [--older-than DAYS]' \
    '       agent-junk-clean --machine-apply KEY... [--older-than DAYS]' \
    '       agent-junk-clean --help' \
    '' \
    'Audit linked Git worktrees and renewable developer caches, then choose' \
    'what to delete with an interactive checklist.' \
    '' \
    'Options:' \
    '  --dry-run  Print safe candidates and protected findings without changing anything.' \
    '  --older-than DAYS' \
    '             Include node_modules whose measured activity age is at least DAYS.' \
    '             DAYS must be an integer from 1 to 365000; the default is 30.' \
    '  --machine-scan' \
    '             Emit a versioned TSV audit for NodeBar without changing anything.' \
    '  --machine-apply KEY...' \
    '             Re-audit and delete only the explicitly selected candidate keys.' \
    '  -h, --help Show this help.' \
    '' \
    'Examples:' \
    '  agent-junk-clean --dry-run --older-than 45' \
    '  agent-junk-clean --older-than 14' \
    '' \
    'Interactive controls: Up/Down move, Space toggles, Enter accepts.' \
    'Deletion requires typing DELETE exactly.' \
    '' \
    'Always excluded: Docker data and commands, Codex sessions/memory/plugins/settings,' \
    'primary worktrees, dirty worktrees, active paths, and unsafe node_modules.' \
    '' \
    'node_modules activity is a conservative filesystem/Git-write proxy: the newest' \
    'mtime among the Git index and tracked or untracked-nonignored project files' \
    'outside dependency trees. It does not mean the last time a project was opened.'
}

progress_status() {
  local message="$1"
  if [[ -t 2 ]]; then
    printf '\r\033[2K%s%s%s' "$DIM" "$message" "$RESET" >&2
    PROGRESS_LINE_ACTIVE=1
  else
    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
  fi
}

progress_end_line() {
  if (( PROGRESS_LINE_ACTIVE == 1 )); then
    printf '\n' >&2
    PROGRESS_LINE_ACTIVE=0
  fi
}

progress_complete() {
  local message="$1"
  if [[ -t 2 ]]; then
    printf '\r\033[2K%s%s%s\n' "$GREEN" "$message" "$RESET" >&2
    PROGRESS_LINE_ACTIVE=0
  else
    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
  fi
}

die() {
  progress_end_line
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

cleanup_terminal() {
  progress_end_line
  if [[ -n "$ORIGINAL_STTY" && -t 0 ]]; then
    stty "$ORIGINAL_STTY" 2>/dev/null || true
  fi
}

handle_interrupt() {
  cleanup_terminal
  printf '\n%s: interrupted.\n' "$PROGRAM_NAME" >&2
  if (( EXECUTION_STARTED == 0 )); then
    printf '%s: no changes were made.\n' "$PROGRAM_NAME" >&2
  else
    printf '%s: execution had started; inspect the summary state before retrying.\n' "$PROGRAM_NAME" >&2
  fi
  exit 130
}

trap cleanup_terminal EXIT
trap handle_interrupt INT TERM HUP

ORIGINAL_ARGUMENT_COUNT=$#
while (( $# > 0 )); do
  case "$1" in
    -h|--help)
      (( ORIGINAL_ARGUMENT_COUNT == 1 )) || die "--help cannot be combined with other arguments"
      usage
      exit 0
      ;;
    --dry-run)
      (( MACHINE_MODE_SEEN == 0 )) || die "--dry-run cannot be combined with machine mode"
      (( DRY_RUN_SEEN == 0 )) || die "--dry-run was provided more than once"
      DRY_RUN=1
      DRY_RUN_SEEN=1
      shift
      ;;
    --machine-scan)
      (( MACHINE_MODE_SEEN == 0 )) || die "machine mode was provided more than once"
      (( DRY_RUN_SEEN == 0 )) || die "--machine-scan cannot be combined with --dry-run"
      MACHINE_MODE="scan"
      MACHINE_MODE_SEEN=1
      shift
      ;;
    --machine-apply)
      (( MACHINE_MODE_SEEN == 0 )) || die "machine mode was provided more than once"
      (( DRY_RUN_SEEN == 0 )) || die "--machine-apply cannot be combined with --dry-run"
      MACHINE_MODE="apply"
      MACHINE_MODE_SEEN=1
      shift
      while (( $# > 0 )); do
        case "$1" in
          --older-than)
            break
            ;;
          --*)
            die "unknown machine-apply option: $1"
            ;;
          *)
            [[ "$1" =~ ^[0-9a-fA-F]{64}$ ]] || die "machine candidate keys must be 64 hexadecimal characters"
            MACHINE_KEYS+=("$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')")
            shift
            ;;
        esac
      done
      (( ${#MACHINE_KEYS[@]} > 0 )) || die "--machine-apply requires at least one candidate key"
      ;;
    --older-than)
      (( OLDER_THAN_SEEN == 0 )) || die "--older-than was provided more than once"
      (( $# >= 2 )) || die "--older-than requires a positive integer DAYS value"
      [[ "$2" =~ ^[0-9]+$ ]] || die "--older-than DAYS must be a positive integer"
      (( ${#2} <= 6 )) || die "--older-than DAYS must not exceed 365000"
      (( 10#$2 > 0 )) || die "--older-than DAYS must be greater than zero"
      (( 10#$2 <= 365000 )) || die "--older-than DAYS must not exceed 365000"
      OLDER_THAN_DAYS=$((10#$2))
      OLDER_THAN_SEEN=1
      shift 2
      ;;
    *)
      die "unknown option: $1 (use --help for usage)"
      ;;
  esac
done

