    machine_emit_result "$@"
  fi
}

machine_auxiliary_key() {
  printf '%s\036%s' "$1" "$2" | shasum -a 256 | awk '{ print $1 }'
}

machine_print_audit() {
  local i key emitted=0 protected=0 total=0
  printf 'HEADER\tAGENT_JUNK_CLEAN_V1\n'
  for ((i = 0; i < ${#PROTECTED_LABEL[@]}; i++)); do
