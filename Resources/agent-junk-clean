path_is_referenced() {
  local path="$1" status
  command -v lsof >/dev/null 2>&1 || return 2
  if lsof -n -P +D "$path" >/dev/null 2>&1; then
    return 0
  else
    status=$?
  fi
  (( status == 1 )) && return 1
  return 2
}

process_pattern_active() {
  local pattern="$1" status
  command -v pgrep >/dev/null 2>&1 || return 2
  if pgrep -f "$pattern" >/dev/null 2>&1; then
    return 0
  else
    status=$?
  fi
  (( status == 1 )) && return 1
  return 2
}

process_command_references_path() {
  local path="$1" pid command process_list
  command -v ps >/dev/null 2>&1 || return 2
  process_list=$(ps -axo pid=,command= 2>/dev/null) || return 2
  while read -r pid command; do
    [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
    [[ "$command" == *"$path"* ]] && return 0
  done <<< "$process_list"
  return 1
}

path_is_active() {
  local path="$1" category="${2:-path}" status
  progress_status "Checking active references for $category: $path"
  if path_is_referenced "$path"; then
    return 0
  else
    status=$?
  fi
  (( status == 1 )) || return 2

  if process_command_references_path "$path"; then
    return 0
  else
    status=$?
  fi
  (( status == 1 )) && return 1
  return 2
}

resolve_path() {
  local path="$1" parent base
  [[ "$path" == /* && "$path" != *$'\n'* && "$path" != *$'\r'* ]] || return 1
  parent=${path%/*}
  base=${path##*/}
  [[ -n "$parent" && -n "$base" && -d "$parent" ]] || return 1
  parent=$(cd "$parent" && pwd -P) || return 1
  printf '%s/%s' "$parent" "$base"
}

is_exact_cache_path() {
  local path="$1" expected
  for expected in \
    "$CLEAN_HOME/.npm/_cacache" \
    "$CLEAN_HOME/Library/Caches/pnpm" \
    "$CLEAN_HOME/.cache/pnpm" \
