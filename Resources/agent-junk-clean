  done
  for ((i = 0; i < ${#CANDIDATE_PATH[@]}; i++)); do
    if key=$(candidate_key "$i"); then
      printf 'CANDIDATE\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$key" \
        "$(machine_base64 "${CANDIDATE_KIND[$i]}")" \
        "$(machine_base64 "${CANDIDATE_LABEL[$i]}")" \
        "${CANDIDATE_SIZE_KB[$i]}" \
