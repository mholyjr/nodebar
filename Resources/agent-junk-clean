        "${CANDIDATE_COUNT[$i]}" \
        "${CANDIDATE_ACTIVITY_EPOCH[$i]}" \
        "$(machine_base64 "${CANDIDATE_ACTIVITY_DATE[$i]}")" \
        "${CANDIDATE_AGE_DAYS[$i]}" \
        "$(machine_base64 "${CANDIDATE_REPO[$i]}")" \
        "$(machine_base64 "${CANDIDATE_REF[$i]}")" \
        "$(machine_base64 "${CANDIDATE_OID[$i]}")"
